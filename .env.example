DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
LT3_ALCHEMY_KEY=

# Optional: restrict /grid to one channel
# DISCORD_GRID_CHANNEL_ID=

# Per-user cooldown in seconds (default 30)
# GRID_COOLDOWN_SECONDS=30

# --- Chat personality (@mention / reply to bot) ---
# Requires Message Content Intent in Discord Developer Portal.
OPENAI_API_KEY=
# Same key as the sales bot — enables live floor price in chat
# OPENSEA_API_KEY=
# CHAT_ENABLED=true
# CHAT_MAX_CHARS=100
# Default gpt-4.1 (falls back to gpt-4o-mini automatically if unavailable). Set gpt-4o-mini to save cost.
# CHAT_LLM_MODEL=gpt-4.1
# Vision analysis when users attach LT3 images (defaults to CHAT_LLM_MODEL)
# CHAT_VISION_MODEL=gpt-4.1
# CHAT_VISION_MAX_CHARS=220
# Comma-separated channel IDs (empty = all except blocklist)
# CHAT_CHANNEL_IDS=
# Block sales-bot and other alert channels (comma-separated IDs)
# CHAT_BLOCKED_CHANNEL_IDS=

# Tools reminder in #main-chat (default 36 hours). Set 0 to disable.
# 0 = disabled (default in code). Set >0 only when slash commands are reliable again.
TOOLS_REMINDER_INTERVAL_HOURS=0
# DISCORD_TOOLS_REMINDER_CHANNEL_ID=
# DISCORD_TOOLS_REMINDER_CHANNEL_NAME=main-chat
